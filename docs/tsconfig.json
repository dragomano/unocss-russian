{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true
  },
  "include": [
    ".vitepress/**/*.ts",
    "components.d.ts",
    "env.d.ts",
    "uno.config.ts",
    "vite.config.ts"
  ]
}
